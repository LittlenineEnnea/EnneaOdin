# 51-samsung-download.rules
# Samsung download mode (Odin / LOKE protocol) - raw USB access for EnneaOdin.
#
# Install:
#   sudo cp 51-samsung-download.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules && sudo udevadm trigger
#
# TAG+="uaccess" grants access to the user logged in at the seat, which is
# the mechanism native/vendor/Heimdall/heimdall/60-heimdall.rules uses. No group and no
# world-writable mode: plugdev does not exist on every distribution, and
# MODE="0666" would make the raw USB node writable by every local process.
#
# Generated by OdinCore.Usb.SamsungIds.UdevRulesText(). Do not hand-edit:
# the ids come from native/vendor/Heimdall/heimdall/source/BridgeManager.h:71,76-78.

SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="04e8", ATTR{idProduct}=="6601", TAG+="uaccess"
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="04e8", ATTR{idProduct}=="685d", TAG+="uaccess"
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="04e8", ATTR{idProduct}=="68c3", TAG+="uaccess"
