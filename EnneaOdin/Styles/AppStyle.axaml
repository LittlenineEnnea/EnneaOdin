<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ── Window ──────────────────────────────────────────────────────── -->
  <Style Selector="Window">
    <Setter Property="Background" Value="#12141C"/>
    <Setter Property="FontFamily" Value="Inter,Segoe UI,San Francisco,Arial,sans-serif"/>
  </Style>

  <!-- ── Card panel ─────────────────────────────────────────────────── -->
  <Style Selector="Border.card">
    <Setter Property="Background"     Value="#1C1F2E"/>
    <Setter Property="CornerRadius"   Value="10"/>
    <Setter Property="Padding"        Value="14"/>
    <Setter Property="Margin"         Value="0,0,0,10"/>
  </Style>

  <!-- ── Section title ──────────────────────────────────────────────── -->
  <Style Selector="TextBlock.section">
    <Setter Property="Foreground"  Value="#5B9BD5"/>
    <Setter Property="FontSize"    Value="11"/>
    <Setter Property="FontWeight"  Value="SemiBold"/>
    <Setter Property="Margin"      Value="0,0,0,8"/>
    <Setter Property="LetterSpacing" Value="1"/>
  </Style>

  <!-- ── Slot label ─────────────────────────────────────────────────── -->
  <Style Selector="TextBlock.slot-lbl">
    <Setter Property="Foreground"        Value="#8899BB"/>
    <Setter Property="FontSize"          Value="12"/>
    <Setter Property="FontWeight"        Value="Bold"/>
    <Setter Property="Width"             Value="76"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <!-- ── Path text box ──────────────────────────────────────────────── -->
  <Style Selector="TextBox.path-box">
    <Setter Property="Background"          Value="#0D0F1A"/>
    <Setter Property="Foreground"          Value="#C8D8F0"/>
    <Setter Property="BorderBrush"         Value="#2A3A5A"/>
    <Setter Property="BorderThickness"     Value="1"/>
    <Setter Property="CornerRadius"        Value="5"/>
    <Setter Property="FontSize"            Value="11"/>
    <Setter Property="FontFamily"          Value="Cascadia Mono,Consolas,monospace"/>
    <Setter Property="Padding"             Value="8,5"/>
    <Setter Property="IsReadOnly"          Value="True"/>
    <Setter Property="VerticalAlignment"   Value="Center"/>
  </Style>
  <Style Selector="TextBox.path-box:pointerover">
    <Setter Property="BorderBrush" Value="#4A6AAA"/>
  </Style>

  <!-- ── Browse / small action buttons ─────────────────────────────── -->
  <Style Selector="Button.btn-browse">
    <Setter Property="Background"      Value="#1E2A4A"/>
    <Setter Property="Foreground"      Value="#7AACFF"/>
    <Setter Property="BorderBrush"     Value="#2E3A6A"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius"    Value="5"/>
    <Setter Property="Padding"         Value="14,5"/>
    <Setter Property="FontSize"        Value="12"/>
    <Setter Property="Cursor"          Value="Hand"/>
  </Style>
  <Style Selector="Button.btn-browse:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#283A6A"/>
  </Style>
  <Style Selector="Button.btn-browse:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="#162040"/>
  </Style>

  <!-- Clear slot button -->
  <Style Selector="Button.btn-clear">
    <Setter Property="Background"      Value="Transparent"/>
    <Setter Property="Foreground"      Value="#556688"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding"         Value="6,4"/>
    <Setter Property="FontSize"        Value="13"/>
    <Setter Property="Cursor"          Value="Hand"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style Selector="Button.btn-clear:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Opacity"    Value="0.8"/>
  </Style>

  <!-- ── FLASH button ───────────────────────────────────────────────── -->
  <Style Selector="Button.btn-flash">
    <Setter Property="Background"      Value="#154A25"/>
    <Setter Property="Foreground"      Value="#50FF80"/>
    <Setter Property="BorderBrush"     Value="#1E6A35"/>
    <Setter Property="BorderThickness" Value="2"/>
    <Setter Property="CornerRadius"    Value="8"/>
    <Setter Property="FontSize"        Value="15"/>
    <Setter Property="FontWeight"      Value="Bold"/>
    <Setter Property="Padding"         Value="40,11"/>
    <Setter Property="Cursor"          Value="Hand"/>
  </Style>
  <Style Selector="Button.btn-flash:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#1E6A35"/>
  </Style>
  <Style Selector="Button.btn-flash:disabled /template/ ContentPresenter">
    <Setter Property="Background" Value="#0E2A16"/>
    <Setter Property="Opacity"    Value="0.45"/>
  </Style>

  <!-- ── STOP button ────────────────────────────────────────────────── -->
  <Style Selector="Button.btn-stop">
    <Setter Property="Background"      Value="#4A1515"/>
    <Setter Property="Foreground"      Value="#FF7070"/>
    <Setter Property="BorderBrush"     Value="#7A2020"/>
    <Setter Property="BorderThickness" Value="2"/>
    <Setter Property="CornerRadius"    Value="8"/>
    <Setter Property="FontSize"        Value="15"/>
    <Setter Property="FontWeight"      Value="Bold"/>
    <Setter Property="Padding"         Value="24,11"/>
    <Setter Property="Cursor"          Value="Hand"/>
  </Style>
  <Style Selector="Button.btn-stop:disabled /template/ ContentPresenter">
    <Setter Property="Background" Value="#2A0E0E"/>
    <Setter Property="Opacity"    Value="0.45"/>
  </Style>

  <!-- ── Scan button ────────────────────────────────────────────────── -->
  <Style Selector="Button.btn-scan">
    <Setter Property="Background"      Value="#1A2840"/>
    <Setter Property="Foreground"      Value="#70BBFF"/>
    <Setter Property="BorderBrush"     Value="#2A3860"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius"    Value="5"/>
    <Setter Property="Padding"         Value="10,5"/>
    <Setter Property="FontSize"        Value="12"/>
    <Setter Property="Cursor"          Value="Hand"/>
  </Style>

  <!-- ── Detect / PIT buttons ───────────────────────────────────────── -->
  <Style Selector="Button.btn-action">
    <Setter Property="Background"      Value="#1A2040"/>
    <Setter Property="Foreground"      Value="#A0C8FF"/>
    <Setter Property="BorderBrush"     Value="#2A3060"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius"    Value="5"/>
    <Setter Property="Padding"         Value="12,6"/>
    <Setter Property="FontSize"        Value="12"/>
    <Setter Property="Cursor"          Value="Hand"/>
  </Style>
  <Style Selector="Button.btn-action:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#243060"/>
  </Style>

  <!-- ── CheckBox ────────────────────────────────────────────────────── -->
  <Style Selector="CheckBox">
    <Setter Property="Foreground" Value="#8AAAC8"/>
    <Setter Property="FontSize"   Value="12"/>
  </Style>
  <Style Selector="CheckBox:checked /template/ Border#NormalRectangle">
    <Setter Property="Background"  Value="#1E5A9A"/>
    <Setter Property="BorderBrush" Value="#2E7ACA"/>
  </Style>

  <!-- ── ComboBox ────────────────────────────────────────────────────── -->
  <Style Selector="ComboBox">
    <Setter Property="Background"  Value="#0D0F1A"/>
    <Setter Property="Foreground"  Value="#C8D8F0"/>
    <Setter Property="BorderBrush" Value="#2A3A5A"/>
    <Setter Property="FontSize"    Value="12"/>
  </Style>

  <!-- ── Log TextBox ─────────────────────────────────────────────────── -->
  <Style Selector="TextBox.log">
    <Setter Property="Background"               Value="#080A12"/>
    <Setter Property="Foreground"               Value="#80FF80"/>
    <Setter Property="CaretBrush"               Value="#80FF80"/>
    <Setter Property="BorderBrush"              Value="#1A2030"/>
    <Setter Property="BorderThickness"          Value="1"/>
    <Setter Property="FontFamily"               Value="Cascadia Mono,Consolas,Monaco,monospace"/>
    <Setter Property="FontSize"                 Value="11"/>
    <Setter Property="IsReadOnly"               Value="True"/>
    <Setter Property="AcceptsReturn"            Value="True"/>
    <Setter Property="TextWrapping"             Value="Wrap"/>
    
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
    
    <Setter Property="Padding"                  Value="10"/>
  </Style>

  <!-- ── Progress bar ────────────────────────────────────────────────── -->
  <Style Selector="ProgressBar">
    <Setter Property="Background"  Value="#0D0F1A"/>
    <Setter Property="Foreground"  Value="#2060E0"/>
    <Setter Property="Height"      Value="10"/>
    <Setter Property="CornerRadius" Value="5"/>
    <Setter Property="BorderThickness" Value="0"/>
  </Style>

  <!-- ── TabItem ─────────────────────────────────────────────────────── -->
  <Style Selector="TabItem">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="#6688AA"/>
    <Setter Property="FontSize"   Value="13"/>
    <Setter Property="Padding"    Value="14,8"/>
  </Style>
  <Style Selector="TabItem:selected">
    <Setter Property="Foreground" Value="#5B9BD5"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>

  <!-- ── Status indicator dot ───────────────────────────────────────── -->
  <Style Selector="Ellipse.dot-ok">
    <Setter Property="Fill"   Value="#40CC60"/>
    <Setter Property="Width"  Value="9"/>
    <Setter Property="Height" Value="9"/>
  </Style>
  <Style Selector="Ellipse.dot-err">
    <Setter Property="Fill"   Value="#CC4040"/>
    <Setter Property="Width"  Value="9"/>
    <Setter Property="Height" Value="9"/>
  </Style>
  <Style Selector="Ellipse.dot-idle">
    <Setter Property="Fill"   Value="#556688"/>
    <Setter Property="Width"  Value="9"/>
    <Setter Property="Height" Value="9"/>
  </Style>

</Styles>
