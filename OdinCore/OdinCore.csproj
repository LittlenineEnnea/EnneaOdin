<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>OdinCore</AssemblyName>
    <RootNamespace>OdinCore</RootNamespace>
    <Version>1.0.0</Version>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <!-- The optional OdinCore.Tests project needs the internal native-bridge
         types (OdinCore.Native) to call the C ABI directly and the internal
         libusb binding to check descriptor parsing. Naming a project that may
         not exist is a no-op. -->
    <InternalsVisibleTo Include="OdinCore.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- Tar reading for Odin .tar / .tar.md5 firmware archives. -->
    <PackageReference Include="SharpZipLib" Version="1.4.2" />
    <!-- LZ4 frame decoding for the .lz4 members Samsung ships inside those
         archives. There is no BCL equivalent of the LZ4 frame format. -->
    <PackageReference Include="K4os.Compression.LZ4.Streams" Version="1.3.8" />
  </ItemGroup>
</Project>
